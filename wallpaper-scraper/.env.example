# Baserow — REQUIRED
BASEROW_API_URL=https://baserow.jymedia.cc
BASEROW_API_TOKEN=your_token_here
BASEROW_TABLE_ID=810

# Scraper
DOWNLOAD_DIR=/data/wallpapers
MAX_CONCURRENT_DOWNLOADS=5
MIN_WIDTH=1920
MIN_HEIGHT=1080
LOG_LEVEL=INFO
HEADLESS=true
REQUEST_DELAY=2

# JPEG Compression
JPEG_QUALITY=85

# AI Model (auto-detected: moondream2 if GPU, blip if CPU-only)
AI_MODEL=auto
# Force a specific model: blip, moondream2

# Web API
API_HOST=0.0.0.0
API_PORT=1629
